# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: Optional PostgreSQL connection URI (e.g., postgresql://user:password@host:5432/dbname)
# If left unset, the system automatically uses persistent local JSON storage at /data/leads_storage.json
DATABASE_URL=""

# Admin Dashboard Authentication
ADMIN_EMAIL="admin@uditdas.com"
ADMIN_PASSWORD="AdminSecret2026!"
SESSION_SECRET="your_production_secure_jwt_secret_key_here"

# SMTP Email Notifications (Optional - if left unset, leads are safely stored in DB without email dispatch)
EMAIL_HOST=""
EMAIL_PORT="587"
EMAIL_USER=""
EMAIL_PASSWORD=""
NOTIFICATION_EMAIL="udit.windows8@gmail.com"

# WhatsApp Business Contact
WHATSAPP_PHONE_NUMBER="919753859045"
